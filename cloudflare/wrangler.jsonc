{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shisetsu-browser-control",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTROL",
        "class_name": "ControlSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ControlSession"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
